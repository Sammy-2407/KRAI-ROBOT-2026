import cv2
import cv2.aruco as aruco

TARGET_ARUCO_ID = 30
last_state = -1

# Inisialisasi ArUco
aruco_dict = aruco.getPredefinedDictionary(
    aruco.DICT_6X6_250
)
detector = aruco.ArucoDetector(aruco_dict)

# Buka kamera
cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()

    if not ret:
        print("Kamera tidak dapat dibaca.")
        break

    gray = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )

    corners, ids, _ = detector.detectMarkers(gray)

    target_detected = False

    if ids is not None:
        # Gambar kotak marker yang terdeteksi
        aruco.drawDetectedMarkers(
            frame,
            corners,
            ids
        )

        detected_ids = ids.flatten()

        if TARGET_ARUCO_ID in detected_ids:
            target_detected = True

            cv2.putText(
                frame,
                f"ARUCO {TARGET_ARUCO_ID} DETECTED",
                (20, 40),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 255, 0),
                2
            )

    # Cetak ke terminal hanya saat status berubah
    if target_detected:
        if last_state != 1:
            print("masuk")
            last_state = 1
    else:
        if last_state != 0:
            print("tidak masuk")
            last_state = 0

    # Tampilkan video
    cv2.imshow("Aruco Detection", frame)

    # Tekan q untuk keluar
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
